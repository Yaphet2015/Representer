{
  "name": "representer",
  "version": "0.1.7",
  "description": "Representer: open-source Chrome extension for AI page summaries, mind-map outlines and chat, BYOK (OpenAI-compatible).",
  "keywords": [
    "chrome-extension",
    "ai",
    "summarizer",
    "ai-summary",
    "mind-map",
    "outline",
    "byok",
    "llm",
    "openai-compatible",
    "wxt",
    "react",
    "typescript",
    "manifest-v3",
    "open-source"
  ],
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "release:patch": "npm version patch -m \"chore: release v%s\"",
    "release:minor": "npm version minor -m \"chore: release v%s\""
  },
  "dependencies": {
    "@earendil-works/chord": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-durable": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "defuddle": "^0.19.5",
    "framer-motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.1",
    "linkedom": "^0.18.13",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
